# ========== MySQL（第二套用独立库 mood_recipe，不与第一套冲突）==========
# 连宿主机 MySQL：DB_HOST=host.docker.internal
# 连第一套 MySQL 容器：DB_HOST=第一套MySQL容器名（需在 docker-compose.yml 加入第一套 external 网络）
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=mood_recipe
DB_USERNAME=root
DB_PASSWORD=你的MySQL密码

# ========== 腾讯云 COS（与第一套共用 bucket，用项目前缀 mood-recipe/ 区分）==========
TENCENT_COS_ENABLED=true
TENCENT_COS_SECRET_ID=你的COS_SECRET_ID
TENCENT_COS_SECRET_KEY=你的COS_SECRET_KEY
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=lq-picture-1367878423
TENCENT_COS_PREFIX=mood-recipe/
TENCENT_COS_DOMAIN=static.image-zero.art

# ========== 微信小程序（第二套独立小程序）==========
WECHAT_APPID=你的小程序appid
WECHAT_SECRET=你的小程序secret

# ========== 微信虚拟支付（个人小程序，与 appid 绑定）==========
WECHAT_VIRTUAL_PAYMENT_OFFER_ID=你的OfferID
WECHAT_VIRTUAL_PAYMENT_APP_KEY=你的AppKey
WECHAT_MESSAGE_PUSH_TOKEN=你的消息推送Token
WECHAT_SESSION_KEY_ENCRYPTION_KEY=Base64编码的32字节随机值

# ========== AI 菜谱推荐（可选，不配置则回退本地菜谱库）==========
AGNES_API_KEY=
AI_RECIPE_MODEL=agnes-2.5-flash
AI_RECIPE_BASE_URL=https://apihub.agnes-ai.com/v1/chat/completions
