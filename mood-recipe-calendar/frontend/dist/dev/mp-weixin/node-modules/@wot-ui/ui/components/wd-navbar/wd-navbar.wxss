.wd-navbar {
  position: relative;
  text-align: center;
  -webkit-user-select: none;
     -moz-user-select: none;
          user-select: none;
  height: var(--wot-navbar-height, var(--wot-n-44, 44px));
  line-height: var(--wot-navbar-height, var(--wot-n-44, 44px));
  background-color: var(--wot-navbar-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  box-sizing: content-box;
}
.wd-navbar__content {
  position: relative;
  height: 100%;
  width: 100%;
}
.wd-navbar__title {
  max-width: 60%;
  height: 100%;
  margin: 0 auto;
  color: var(--wot-navbar-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  font-weight: var(--wot-navbar-title-font-weight, var(--wot-font-weight-medium, 600));
  font-size: var(--wot-navbar-title-font-size, var(--wot-typography-title-size-main, var(--wot-n-18, 18px)));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-navbar__text {
  display: inline-block;
  vertical-align: middle;
  color: var(--wot-navbar-desc-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
}
.wd-navbar__left, .wd-navbar__right, .wd-navbar__capsule {
  position: absolute;
  top: 0;
  bottom: 0;
  font-size: var(--wot-navbar-desc-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  display: flex;
  align-items: center;
  padding: var(--wot-navbar-left-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
}
.wd-navbar__left.is-disabled, .wd-navbar__right.is-disabled, .wd-navbar__capsule.is-disabled {
  opacity: var(--wot-navbar-opacity-disabled, var(--wot-opacity-disabled, 0.4));
}
.wd-navbar__left, .wd-navbar__capsule {
  left: 0;
}
.wd-navbar__right {
  right: 0;
}
.wd-navbar  .wd-navbar__arrow {
  font-size: var(--wot-navbar-arrow-size, var(--wot-n-24, 24px));
  color: var(--wot-navbar-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
}
.wd-navbar.is-border {
  position: relative;
}
.wd-navbar.is-border::after {
  position: absolute;
  display: block;
  content: "";
  width: 100%;
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: 0;
  bottom: 0;
  transform: scaleY(0.5);
  background: var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb));
}
.wd-navbar.is-fixed {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: var(--wot-navbar-z-index, 10);
}