.wd-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--wot-loading-color-main, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  font-size: var(--wot-loading-size, var(--wot-n-28, 28px));
}
.wd-loading--horizontal {
  flex-direction: row;
}
.wd-loading--horizontal .wd-loading__text {
  margin-left: var(--wot-loading-text-spacing, var(--wot-spacing-extra-tight, var(--wot-n-6, 6px)));
}
.wd-loading--vertical {
  flex-direction: column;
}
.wd-loading--vertical .wd-loading__text {
  margin-top: var(--wot-loading-text-spacing, var(--wot-spacing-extra-tight, var(--wot-n-6, 6px)));
}
.wd-loading__spinner {
  flex: none;
  position: relative;
  font-size: inherit;
  width: var(--wot-loading-size-width, 1em);
  height: var(--wot-loading-size-height, 1em);
  animation: wd-rotate var(--wot-loading-spinner-animation-duration, 0.8s) linear infinite;
  padding: var(--wot-loading-spinner-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px)));
  box-sizing: border-box;
}
.wd-loading__spinner--circular .wd-loading__spinner-wraper {
  border-radius: var(--wot-loading-spinner-circle-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  border: none;
  -webkit-mask: radial-gradient(closest-side, transparent calc(100% - var(--wot-loading-spinner-circle-stroke-width, 15%)), var(--wot-base-white, white) calc(100% - var(--wot-loading-spinner-circle-stroke-width, 15%)), var(--wot-base-white, white) 100%);
          mask: radial-gradient(closest-side, transparent calc(100% - var(--wot-loading-spinner-circle-stroke-width, 15%)), var(--wot-base-white, white) calc(100% - var(--wot-loading-spinner-circle-stroke-width, 15%)), var(--wot-base-white, white) 100%);
  background: conic-gradient(from 0deg at 50% 50%, var(--wot-base-transparent, transparent) 0deg, var(--wot-base-transparent, transparent) 90deg, currentColor 330deg, currentColor 360deg);
}
.wd-loading__spinner--spinner {
  animation-timing-function: steps(12);
}
.wd-loading__spinner--dots {
  animation: none;
}
.wd-loading__spinner--dots .wd-loading__spinner-wraper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.wd-loading__spinner--dots .wd-loading__spinner-dot {
  position: static;
  width: var(--wot-loading-spinner-dots-dot-size, 20%);
  height: var(--wot-loading-spinner-dots-dot-size, 20%);
  border-radius: var(--wot-loading-spinner-dots-dot-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  background-color: currentColor;
  animation-name: wd-dotting;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-fill-mode: both;
}
.wd-loading__spinner--dots .wd-loading__spinner-dot::before {
  content: none;
}
.wd-loading__spinner--dots .wd-loading__spinner-dot:nth-of-type(1) {
  animation-delay: calc(var(--wot-loading-spinner-animation-duration, 0.8s) * 0 / 3);
  animation-duration: var(--wot-loading-spinner-animation-duration, 0.8s);
}
.wd-loading__spinner--dots .wd-loading__spinner-dot:nth-of-type(2) {
  animation-delay: calc(var(--wot-loading-spinner-animation-duration, 0.8s) * 1 / 3);
  animation-duration: var(--wot-loading-spinner-animation-duration, 0.8s);
}
.wd-loading__spinner--dots .wd-loading__spinner-dot:nth-of-type(3) {
  animation-delay: calc(var(--wot-loading-spinner-animation-duration, 0.8s) * 2 / 3);
  animation-duration: var(--wot-loading-spinner-animation-duration, 0.8s);
}
.wd-loading__spinner--wave {
  animation: none;
}
.wd-loading__spinner--wave .wd-loading__spinner-wraper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}
.wd-loading__spinner--wave .wd-loading__spinner-wave-bar {
  display: flex;
  align-items: center;
  animation-duration: var(--wot-loading-wave-animation-duration, 834ms);
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.wd-loading__spinner--wave .wd-loading__spinner-wave-bar:nth-of-type(n + 2) {
  margin-left: var(--wot-loading-wave-gap, 6.25%);
}
.wd-loading__spinner-dot {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.wd-loading__spinner-dot:nth-of-type(1) {
  transform: rotate(60deg);
  opacity: 1;
}
.wd-loading__spinner-dot:nth-of-type(2) {
  transform: rotate(30deg);
  opacity: 0.9375;
}
.wd-loading__spinner-dot:nth-of-type(3) {
  transform: rotate(0deg);
  opacity: 0.875;
}
.wd-loading__spinner-dot:nth-of-type(4) {
  transform: rotate(-30deg);
  opacity: 0.8125;
}
.wd-loading__spinner-dot:nth-of-type(5) {
  transform: rotate(-60deg);
  opacity: 0.75;
}
.wd-loading__spinner-dot:nth-of-type(6) {
  transform: rotate(-90deg);
  opacity: 0.6875;
}
.wd-loading__spinner-dot:nth-of-type(7) {
  transform: rotate(-120deg);
  opacity: 0.625;
}
.wd-loading__spinner-dot:nth-of-type(8) {
  transform: rotate(-150deg);
  opacity: 0.5625;
}
.wd-loading__spinner-dot:nth-of-type(9) {
  transform: rotate(-180deg);
  opacity: 0.5;
}
.wd-loading__spinner-dot:nth-of-type(10) {
  transform: rotate(-210deg);
  opacity: 0.4375;
}
.wd-loading__spinner-dot:nth-of-type(11) {
  transform: rotate(-240deg);
  opacity: 0.375;
}
.wd-loading__spinner-dot:nth-of-type(12) {
  transform: rotate(-270deg);
  opacity: 0.3125;
}
.wd-loading__spinner-dot::before {
  display: block;
  width: var(--wot-loading-spinner-dot-width, 10%);
  height: var(--wot-loading-spinner-dot-height, 25%);
  margin: 0 auto;
  background-color: currentColor;
  border-radius: var(--wot-loading-spinner-dot-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  content: " ";
}
.wd-loading__spinner-wraper {
  position: relative;
  width: 100%;
  height: 100%;
}
.wd-loading__spinner-wave-bar {
  flex: none;
  width: var(--wot-loading-wave-bar-width, 12.5%);
  height: var(--wot-loading-wave-bar-height, 83.333333%);
}
.wd-loading__spinner-wave-bar:nth-of-type(1) .wd-loading__spinner-wave-bar-inner {
  animation-name: wd-wave-bar-1;
}
.wd-loading__spinner-wave-bar:nth-of-type(2) .wd-loading__spinner-wave-bar-inner {
  animation-name: wd-wave-bar-2;
}
.wd-loading__spinner-wave-bar:nth-of-type(3) .wd-loading__spinner-wave-bar-inner {
  animation-name: wd-wave-bar-3;
}
.wd-loading__spinner-wave-bar:nth-of-type(4) .wd-loading__spinner-wave-bar-inner {
  animation-name: wd-wave-bar-4;
}
.wd-loading__spinner-wave-bar-inner {
  width: 100%;
  height: 100%;
  border-radius: var(--wot-loading-wave-bar-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  background-color: currentColor;
  animation-duration: var(--wot-loading-wave-animation-duration, 834ms);
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  will-change: height;
}
.wd-loading__text {
  font-size: var(--wot-loading-text-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-loading-text-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: currentColor;
}
@keyframes wd-rotate {
from {
    transform: rotate(0deg);
}
to {
    transform: rotate(360deg);
}
}
@keyframes wd-dotting {
0% {
    opacity: 0.15;
}
1% {
    opacity: 0.8;
}
33% {
    opacity: 0.8;
}
34% {
    opacity: 0.15;
}
100% {
    opacity: 0.15;
}
}
@keyframes wd-wave-bar-1 {
0%, 100% {
    height: 20%;
}
25.779376%, 87.889688% {
    height: 40%;
}
37.889688%, 75.779376% {
    height: 70%;
}
50% {
    height: 100%;
}
}
@keyframes wd-wave-bar-2 {
0%, 100% {
    height: 40%;
}
25.779376%, 87.889688%, 50% {
    height: 70%;
}
37.889688%, 75.779376% {
    height: 100%;
}
}
@keyframes wd-wave-bar-3 {
0%, 100%, 37.889688%, 75.779376% {
    height: 70%;
}
25.779376%, 87.889688% {
    height: 100%;
}
50% {
    height: 40%;
}
}
@keyframes wd-wave-bar-4 {
0%, 100% {
    height: 100%;
}
25.779376%, 87.889688% {
    height: 70%;
}
37.889688%, 75.779376% {
    height: 40%;
}
50% {
    height: 20%;
}
}