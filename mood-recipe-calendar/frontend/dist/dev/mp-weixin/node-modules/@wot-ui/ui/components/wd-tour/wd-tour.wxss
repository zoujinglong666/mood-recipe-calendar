.wd-tour {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: var(--wot-tour-z-index, 999);
}
.wd-tour__mask {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
}
.wd-tour__highlight {
  position: fixed;
  background: transparent;
  box-sizing: content-box;
  animation: tour-show var(--wot-tour-animation-duration, 0.3s) var(--wot-tour-highlight-animation-timing, ease-in-out);
  top: 0;
  left: 0;
  width: 100vw;
  height: 0;
  border-radius: 0;
  padding: 0;
}
.wd-tour__highlight--mask {
  box-shadow: 0 0 0 100vh var(--wot-tour-highlight-shadow-color, var(--wot-opac-7_55, rgba(0, 0, 0, 0.5490196078)));
}
.wd-tour__popover {
  z-index: var(--wot-tour-popover-z-index, 1000);
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  max-width: var(--wot-tour-popover-max-width, calc(var(--wot-n-1, 1px) * 340));
  text-align: center;
  transition: var(--wot-tour-animation-duration, 0.3s) all;
  background-color: var(--wot-tour-popover-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  padding: var(--wot-tour-popover-padding, var(--wot-padding-loose, var(--wot-n-12, 12px)));
  border-radius: var(--wot-tour-popover-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
  width: -moz-fit-content;
  width: fit-content;
  min-width: var(--wot-tour-popover-min-width, calc(var(--wot-n-1, 1px) * 200));
}
.wd-tour__info {
  font-size: var(--wot-tour-info-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-tour-info-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-tour-info-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  width: -moz-fit-content;
  width: fit-content;
  text-align: left;
  word-break: break-all;
}
.wd-tour__buttons {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: var(--wot-tour-buttons-margin-top, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
@keyframes tour-show {
0% {
    opacity: 0;
}
100% {
    opacity: 1;
}
}