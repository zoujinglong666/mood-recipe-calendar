.wd-switch {
  display: inline-flex;
  align-items: center;
  position: relative;
  font-size: var(--wot-switch-size, var(--wot-n-26, 26px));
  vertical-align: middle;
}
.wd-switch.is-disabled {
  opacity: var(--wot-switch-disabled, var(--wot-opacity-disabled, 0.4));
}
.wd-switch.is-loading {
  opacity: var(--wot-opacity-overlay, 0.75);
}
.wd-switch__inner {
  box-sizing: border-box;
  font-size: inherit;
  display: flex;
  align-items: center;
  min-width: var(--wot-switch-size-inner-min-width, calc(1.8em + var(--wot-switch-top-bottom-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px))) * 2));
  height: var(--wot-switch-size-inner-height, calc(var(--wot-switch-size-action-height, 1em) + var(--wot-switch-top-bottom-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px))) * 2));
  transition: all var(--wot-switch-transition-duration, 0.3s) ease;
  border-radius: var(--wot-switch-radius-full, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  padding: var(--wot-switch-top-bottom-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px))) var(--wot-switch-left-right-padding, var(--wot-padding-tight, var(--wot-n-8, 8px)));
}
.wd-switch__action {
  position: absolute;
  box-sizing: border-box;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  font-size: inherit;
  width: var(--wot-switch-size-action-width, 1em);
  height: var(--wot-switch-size-action-height, 1em);
  background: var(--wot-switch-color-action-bg, var(--wot-base-white, white));
  border-radius: var(--wot-switch-radius-action-full, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  transition: all var(--wot-switch-transition-duration, 0.3s) ease;
  left: var(--wot-switch-top-bottom-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px)));
}
.wd-switch--round .wd-switch__inner {
  border-radius: var(--wot-switch-radius-full, var(--wot-radius-full, var(--wot-n-full, 9999px)));
}
.wd-switch--round .wd-switch__action {
  border-radius: var(--wot-switch-radius-action-full, var(--wot-radius-full, var(--wot-n-full, 9999px)));
}
.wd-switch--square .wd-switch__inner {
  border-radius: var(--wot-switch-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
}
.wd-switch--square .wd-switch__action {
  border-radius: var(--wot-switch-radius-action, var(--wot-radius-small, var(--wot-n-2, 2px)));
}
.wd-switch  .wd-switch__action-loading {
  font-size: var(--wot-switch-size-action-icon, 0.5em);
}
.wd-switch__inner-text {
  font-size: var(--wot-switch-inner-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
}
.wd-switch  .wd-switch__inner-icon {
  font-size: var(--wot-switch-size-icon, 0.5em);
}
.wd-switch  .wd-switch__action-icon {
  font-size: var(--wot-switch-size-action-icon, 0.5em);
  color: var(--wot-switch-color-action-icon, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-switch.is-active .wd-switch__inner {
  background: var(--wot-switch-color-active-bg, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  padding-right: calc(var(--wot-switch-size-action-width, 1em) + var(--wot-switch-top-bottom-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px))));
}
.wd-switch.is-active .wd-switch__inner-icon {
  color: var(--wot-switch-color-active-icon, var(--wot-icon-white, var(--wot-base-white, white)));
  margin-right: var(--wot-switch-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}
.wd-switch.is-active .wd-switch__inner-text {
  color: var(--wot-switch-color-inner-active-text, var(--wot-text-white, var(--wot-base-white, white)));
  margin-right: var(--wot-switch-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}
.wd-switch.is-active .wd-switch__action {
  left: calc(100% - var(--wot-switch-size-action-width, 1em) - var(--wot-switch-top-bottom-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px))));
}
.wd-switch.is-inactive .wd-switch__inner {
  background: var(--wot-switch-color-inactive-bg, var(--wot-filled-strong, var(--wot-coolgrey-3, #e5e6eb)));
  padding-left: calc(var(--wot-switch-size-action-width, 1em) + var(--wot-switch-top-bottom-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px))));
}
.wd-switch.is-inactive .wd-switch__inner-icon {
  color: var(--wot-switch-color-inactive-icon, var(--wot-icon-auxiliary, var(--wot-coolgrey-6, #868a9c)));
  margin-left: var(--wot-switch-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}
.wd-switch.is-inactive .wd-switch__inner-text {
  color: var(--wot-switch-color-inner-inactive-text, var(--wot-text-auxiliary, var(--wot-coolgrey-6, #868a9c)));
  margin-left: var(--wot-switch-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}