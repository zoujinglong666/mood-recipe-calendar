.wd-swiper-nav__btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--wot-swiper-nav-btn-size, var(--wot-n-24, 24px));
  height: var(--wot-swiper-nav-btn-size, var(--wot-n-24, 24px));
  border-radius: var(--wot-swiper-nav-btn-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  background: var(--wot-swiper-nav-btn-bg, var(--wot-opacfilled-main-cover, var(--wot-opac-7_55, rgba(0, 0, 0, 0.5490196078))));
}
.wd-swiper-nav__btn--prev {
  left: var(--wot-swiper-nav-btn-spacing, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
}
.wd-swiper-nav__btn--next {
  right: var(--wot-swiper-nav-btn-spacing, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
}
.wd-swiper-nav  .wd-swiper-nav__btn-icon {
  font-size: var(--wot-swiper-nav-btn-icon-size, var(--wot-n-16, 16px));
  line-height: var(--wot-swiper-nav-btn-icon-size, var(--wot-n-16, 16px));
  color: var(--wot-swiper-nav-btn-color, var(--wot-icon-white, var(--wot-base-white, white)));
}
.wd-swiper-nav--dots, .wd-swiper-nav--dots-bar {
  display: flex;
  flex-direction: row;
}
.wd-swiper-nav--fraction {
  padding: var(--wot-swiper-nav-fraction-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px)) var(--wot-padding-extra-tight, var(--wot-n-6, 6px)));
  line-height: var(--wot-swiper-nav-fraction-line-height, var(--wot-typography-label-line-height-size-large, var(--wot-n-18, 18px)));
  border-radius: var(--wot-swiper-nav-fraction-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
  background: var(--wot-swiper-nav-fraction-bg, var(--wot-opacfilled-main-cover, var(--wot-opac-7_55, rgba(0, 0, 0, 0.5490196078))));
  color: var(--wot-swiper-nav-fraction-color, var(--wot-icon-white, var(--wot-base-white, white)));
  font-size: var(--wot-swiper-nav-fraction-font-size, var(--wot-typography-label-size-large, var(--wot-n-14, 14px)));
}
.wd-swiper-nav__item--dots, .wd-swiper-nav__item--dots-bar {
  width: var(--wot-swiper-nav-dot-size, var(--wot-n-6, 6px));
  height: var(--wot-swiper-nav-dot-size, var(--wot-n-6, 6px));
  background: var(--wot-swiper-nav-dot-color, var(--wot-filled-extra-strong, var(--wot-coolgrey-4, #c9cbd4)));
  border-radius: var(--wot-swiper-nav-dot-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  margin: 0 var(--wot-swiper-nav-dot-margin, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
  transition: all 0.4s ease-in;
}
.wd-swiper-nav__item--dots.is-vertical, .wd-swiper-nav__item--dots-bar.is-vertical {
  margin: var(--wot-swiper-nav-dot-margin, var(--wot-spacing-super-tight, var(--wot-n-4, 4px))) 0;
}
.wd-swiper-nav__item--dots.is-active, .wd-swiper-nav__item--dots-bar.is-active {
  background: var(--wot-swiper-nav-dot-color-active, var(--wot-icon-white, var(--wot-base-white, white)));
}
.wd-swiper-nav__item--dots-bar.is-vertical.is-active {
  width: var(--wot-swiper-nav-dot-size, var(--wot-n-6, 6px));
  height: var(--wot-swiper-nav-dots-bar-width-active, var(--wot-n-15, 15px));
}
.wd-swiper-nav__item--dots-bar.is-active {
  width: var(--wot-swiper-nav-dots-bar-width-active, var(--wot-n-15, 15px));
  border-radius: var(--wot-swiper-nav-dot-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  background: var(--wot-swiper-nav-dot-color-active, var(--wot-icon-white, var(--wot-base-white, white)));
}
.wd-swiper-nav--left {
  position: absolute;
  left: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  top: 50%;
  transform: translateY(-50%);
}
.wd-swiper-nav--right {
  position: absolute;
  right: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  top: 50%;
  transform: translateY(-50%);
}
.wd-swiper-nav--top-left {
  position: absolute;
  top: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  left: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-swiper-nav--top {
  position: absolute;
  left: 50%;
  top: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  transform: translateX(-50%);
}
.wd-swiper-nav--top-right {
  position: absolute;
  top: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  right: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-swiper-nav--bottom-left {
  position: absolute;
  left: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  bottom: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-swiper-nav--bottom {
  position: absolute;
  left: 50%;
  bottom: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  transform: translateX(-50%);
}
.wd-swiper-nav--bottom-right {
  position: absolute;
  right: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  bottom: var(--wot-swiper-nav-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-swiper-nav--vertical {
  flex-direction: column;
}