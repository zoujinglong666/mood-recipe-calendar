.wd-transition {
  transition-timing-function: ease;
}
.wd-transition--fade-enter, .wd-transition--fade-leave-to {
  opacity: 0;
}
.wd-transition--fade-enter-active, .wd-transition--fade-leave-active {
  transition-property: opacity;
}
.wd-transition--fade-up-enter, .wd-transition--fade-up-leave-to {
  transform: translate3d(0, 100%, 0);
  opacity: 0;
}
.wd-transition--fade-down-enter, .wd-transition--fade-down-leave-to {
  transform: translate3d(0, -100%, 0);
  opacity: 0;
}
.wd-transition--fade-left-enter, .wd-transition--fade-left-leave-to {
  transform: translate3d(-100%, 0, 0);
  opacity: 0;
}
.wd-transition--fade-right-enter, .wd-transition--fade-right-leave-to {
  transform: translate3d(100%, 0, 0);
  opacity: 0;
}
.wd-transition--slide-up-enter, .wd-transition--slide-up-leave-to {
  transform: translate3d(0, 100%, 0);
}
.wd-transition--slide-down-enter, .wd-transition--slide-down-leave-to {
  transform: translate3d(0, -100%, 0);
}
.wd-transition--slide-left-enter, .wd-transition--slide-left-leave-to {
  transform: translate3d(-100%, 0, 0);
}
.wd-transition--slide-right-enter, .wd-transition--slide-right-leave-to {
  transform: translate3d(100%, 0, 0);
}
.wd-transition--zoom-in-enter, .wd-transition--zoom-in-leave-to {
  opacity: 0;
  transform: scale(0.8);
}
.wd-transition--zoom-out-enter, .wd-transition--zoom-out-leave-to {
  transform: scale(1.2);
  opacity: 0;
}
.wd-transition--zoom-in-enter-active, .wd-transition--zoom-in-leave-active, .wd-transition--zoom-out-enter-active, .wd-transition--zoom-out-leave-active, .wd-transition--fade-up-enter-active, .wd-transition--fade-up-leave-active, .wd-transition--fade-down-enter-active, .wd-transition--fade-down-leave-active, .wd-transition--fade-left-enter-active, .wd-transition--fade-left-leave-active, .wd-transition--fade-right-enter-active, .wd-transition--fade-right-leave-active {
  transition-property: opacity, transform;
}
.wd-transition--slide-up-enter-active, .wd-transition--slide-up-leave-active, .wd-transition--slide-down-enter-active, .wd-transition--slide-down-leave-active, .wd-transition--slide-left-enter-active, .wd-transition--slide-left-leave-active, .wd-transition--slide-right-enter-active, .wd-transition--slide-right-leave-active {
  transition-property: transform;
}