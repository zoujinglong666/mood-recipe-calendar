.wd-radio {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}
.wd-radio--horizontal {
  display: inline-flex;
  justify-content: flex-start;
  vertical-align: middle;
}
.wd-radio--horizontal:not(:last-child) {
  margin: var(--wot-radio-horizontal-margin, var(--wot-spacing-zero, var(--wot-n-0, 0px)) var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)) var(--wot-spacing-zero, var(--wot-n-0, 0px)) var(--wot-spacing-zero, var(--wot-n-0, 0px)));
}
.wd-radio--right .wd-radio__label {
  margin-right: var(--wot-radio-label-margin, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-radio--left {
  flex-direction: row-reverse;
  justify-content: flex-end;
}
.wd-radio--left .wd-radio__label {
  margin-left: var(--wot-radio-label-margin, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-radio  .wd-radio__icon {
  font-size: var(--wot-radio-icon-size, var(--wot-n-22, 22px));
  height: var(--wot-radio-icon-size, var(--wot-n-22, 22px));
  line-height: var(--wot-radio-icon-size, var(--wot-n-22, 22px));
  color: var(--wot-radio-unchecked-color, var(--wot-coolgrey-3, #e5e6eb));
  transition: all 0.2s;
}
.wd-radio__label {
  font-size: var(--wot-radio-label-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  color: var(--wot-radio-label-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  line-height: var(--wot-radio-label-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  text-align: center;
  word-break: break-all;
}
.wd-radio__shape {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.wd-radio.is-checked .wd-radio__icon {
  color: var(--wot-radio-checked-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-radio.is-button {
  display: inline-block;
  min-width: var(--wot-radio-button-min-width, 74px);
  max-width: var(--wot-radio-button-max-width, 148px);
  margin: var(--wot-radio-button-margin, var(--wot-spacing-zero, var(--wot-n-0, 0px)) var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)) var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)) var(--wot-spacing-zero, var(--wot-n-0, 0px)));
  border-radius: var(--wot-radio-button-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
  background: var(--wot-radio-button-bg, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
  font-size: var(--wot-radio-button-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  box-sizing: border-box;
  border: var(--wot-radio-button-border-width, var(--wot-n-1, 1px)) solid var(--wot-radio-button-bg, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
}
.wd-radio.is-button .wd-radio__label {
  position: relative;
  padding: var(--wot-radio-button-padding, var(--wot-padding-extra-tight, var(--wot-n-6, 6px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
  margin: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-radio.is-button .wd-radio__shape {
  position: absolute;
  top: var(--wot-radio-button-shape-top, calc(-1 * var(--wot-n-11, 11px)));
  left: var(--wot-radio-button-shape-left, calc(-1 * var(--wot-n-9, 9px)));
  width: var(--wot-radio-button-shape-size, var(--wot-n-26, 26px));
  height: var(--wot-radio-button-shape-size, var(--wot-n-26, 26px));
  border-radius: var(--wot-radio-button-shape-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  background: transparent;
}
.wd-radio.is-button .wd-radio__icon {
  position: absolute;
  top: var(--wot-radio-button-icon-top, calc(13 * var(--wot-n-1, 1px)));
  right: var(--wot-radio-button-icon-right, var(--wot-n-4, 4px));
  font-size: var(--wot-radio-button-icon-size, var(--wot-n-10, 10px));
  line-height: var(--wot-radio-button-icon-size, var(--wot-n-10, 10px));
  height: var(--wot-radio-button-icon-size, var(--wot-n-10, 10px));
  color: var(--wot-radio-button-icon-color, var(--wot-icon-white, var(--wot-base-white, white)));
}
.wd-radio.is-button.wd-radio--right .wd-radio__shape {
  left: auto;
  right: var(--wot-radio-button-shape-right, calc(-1 * var(--wot-n-9, 9px)));
}
.wd-radio.is-button.wd-radio--right .wd-radio__icon {
  right: auto;
  left: var(--wot-radio-button-icon-left, var(--wot-n-4, 4px));
}
.wd-radio.is-button.is-checked {
  color: var(--wot-radio-checked-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  border-color: currentColor;
  background: var(--wot-radio-button-checked-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
}
.wd-radio.is-button.is-checked .wd-radio__shape {
  color: var(--wot-radio-checked-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  background: currentColor;
}
.wd-radio.is-disabled {
  opacity: var(--wot-radio-disabled, var(--wot-opacity-disabled, 0.4));
}