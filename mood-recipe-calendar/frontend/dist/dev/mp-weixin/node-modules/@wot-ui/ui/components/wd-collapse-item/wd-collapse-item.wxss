.wd-collapse-item {
  position: relative;
}
.wd-collapse-item.is-border {
  position: relative;
}
.wd-collapse-item.is-border::after {
  position: absolute;
  display: block;
  content: "";
  width: 100%;
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: 0;
  top: 0;
  transform: scaleY(0.5);
  background: var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb));
}
.wd-collapse-item.is-border .wd-collapse-item__header.is-expanded {
  position: relative;
}
.wd-collapse-item.is-border .wd-collapse-item__header.is-expanded::after {
  position: absolute;
  display: block;
  content: "";
  width: 100%;
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: 0;
  bottom: 0;
  transform: scaleY(0.5);
  background: var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb));
}
.wd-collapse-item__header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--wot-collapse-item-header-padding, var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
  overflow: hidden;
  -webkit-user-select: none;
     -moz-user-select: none;
          user-select: none;
}
.wd-collapse-item__header.is-custom {
  display: block;
}
.wd-collapse-item__title {
  color: var(--wot-collapse-item-title-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  font-size: var(--wot-collapse-item-title-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  line-height: var(--wot-collapse-item-title-line-height, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
}
.wd-collapse-item  .wd-collapse-item__arrow {
  display: block;
  font-size: var(--wot-collapse-item-arrow-size, var(--wot-n-16, 16px));
  color: var(--wot-collapse-item-arrow-color, var(--wot-icon-secondary, var(--wot-coolgrey-8, #4e5369)));
  transition: transform 0.3s;
}
.wd-collapse-item  .wd-collapse-item__arrow.is-retract {
  transform: rotate(-180deg);
}
.wd-collapse-item__wrapper {
  position: relative;
  overflow: hidden;
  will-change: height;
}
.wd-collapse-item__body {
  color: var(--wot-collapse-item-body-color, var(--wot-text-auxiliary, var(--wot-coolgrey-6, #868a9c)));
  font-size: var(--wot-collapse-item-body-font-size, var(--wot-typography-label-size-large, var(--wot-n-14, 14px)));
  line-height: var(--wot-collapse-item-body-line-height, var(--wot-typography-label-line-height-size-large, var(--wot-n-18, 18px)));
  padding: var(--wot-collapse-item-body-padding, var(--wot-padding-loose, var(--wot-n-12, 12px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
}
.wd-collapse-item.is-disabled {
  opacity: var(--wot-opacity-disabled, 0.4);
}