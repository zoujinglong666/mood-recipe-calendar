.wd-badge {
  position: relative;
  vertical-align: middle;
  display: inline-block;
}
.wd-badge__content {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: var(--wot-badge-height, var(--wot-n-16, 16px));
  padding: var(--wot-badge-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-super-tight, var(--wot-n-4, 4px)));
  background: var(--wot-badge-danger-bg, var(--wot-danger-main, var(--wot-red-6, #f14646)));
  border-radius: var(--wot-badge-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
  color: var(--wot-badge-color, var(--wot-text-white, var(--wot-base-white, white)));
  font-size: var(--wot-badge-font-size, var(--wot-typography-label-size-extra-small, var(--wot-n-10, 10px)));
  line-height: var(--wot-badge-line-height, var(--wot-typography-label-line-height-size-extra-small, var(--wot-n-16, 16px)));
  font-weight: var(--wot-badge-font-weight, var(--wot-font-weight-medium, 600));
  min-width: var(--wot-badge-min-width, var(--wot-n-16, 16px));
}
.wd-badge__content.is-dot {
  height: var(--wot-badge-dot-size, var(--wot-n-6, 6px));
  width: var(--wot-badge-dot-size, var(--wot-n-6, 6px));
  min-width: var(--wot-badge-dot-size, var(--wot-n-6, 6px));
  padding: 0;
  border-radius: var(--wot-badge-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
}
.wd-badge__content.is-square {
  border-radius: var(--wot-badge-square-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
}
.wd-badge__content.is-bubble {
  border-radius: var(--wot-badge-bubble-border-radius, var(--wot-radius-large, var(--wot-n-8, 8px)) var(--wot-radius-large, var(--wot-n-8, 8px)) var(--wot-radius-large, var(--wot-n-8, 8px)) var(--wot-radius-zero, var(--wot-n-0, 0px)));
}
.wd-badge__content.is-border {
  position: relative;
}
.wd-badge__content.is-border::after {
  position: absolute;
  display: block;
  content: " ";
  pointer-events: none;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  border: var(--wot-stroke-main, var(--wot-n-1, 1px)) solid var(--wot-badge-border-color, var(--wot-border-white, var(--wot-base-white, white)));
  box-sizing: border-box;
  border-radius: inherit;
}
.wd-badge__content.is-fixed {
  position: absolute;
  top: 0px;
  right: 0px;
  z-index: 1;
  transform: var(--wot-badge-transform, translateY(-50%) translateX(50%));
}
.wd-badge__content--primary {
  background: var(--wot-badge-primary-bg, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-badge__content--success {
  background: var(--wot-badge-success-bg, var(--wot-success-main, var(--wot-green-6, #12b886)));
}
.wd-badge__content--warning {
  background: var(--wot-badge-warning-bg, var(--wot-warning-main, var(--wot-orange-6, #f57f00)));
}
.wd-badge__content--info {
  background: var(--wot-badge-info-bg, var(--wot-filled-content, var(--wot-coolgrey-2, #f2f3f5)));
  color: var(--wot-badge-info-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-badge__content--danger {
  background: var(--wot-badge-danger-bg, var(--wot-danger-main, var(--wot-red-6, #f14646)));
}