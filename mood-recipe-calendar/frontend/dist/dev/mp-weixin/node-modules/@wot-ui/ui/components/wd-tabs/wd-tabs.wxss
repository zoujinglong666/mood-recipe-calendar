  width: var(--wot-tabs-map-btn-width, var(--wot-n-44, 44px));
  height: var(--wot-tabs-map-btn-height, var(--wot-n-44, 44px));
}
.wd-tabs__map-btn::before {
  position: absolute;
  content: "";
  top: 0;
  left: 0;
  width: var(--wot-n-24, 24px);
  transform: translateX(-100%);
