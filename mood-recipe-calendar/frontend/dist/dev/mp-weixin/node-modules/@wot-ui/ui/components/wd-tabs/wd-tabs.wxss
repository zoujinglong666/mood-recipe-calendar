.wd-tabs {
  position: relative;
  background: var(--wot-tabs-nav-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  width: 100%;
}
.wd-tabs.is-hide-scrollbar ::-webkit-scrollbar {
  width: 0;
  height: 0;
  -webkit-appearance: none;
}
.wd-tabs__nav {
  position: relative;
  left: 0;
  right: 0;
  width: 100%;
  background: var(--wot-tabs-nav-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
}
.wd-tabs__nav--wrap {
  height: 100%;
  overflow: hidden;
}
.wd-tabs__nav--sticky {
  width: var(--wot-tabs-nav-sticky-width, 100vw);
}
.wd-tabs__nav-container {
  position: relative;
  display: flex;
  -webkit-user-select: none;
     -moz-user-select: none;
          user-select: none;
}
.wd-tabs__nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  font-size: var(--wot-tabs-nav-item-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  line-height: var(--wot-tabs-nav-item-line-height, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
  padding: var(--wot-tabs-nav-item-padding, var(--wot-padding-main, var(--wot-n-10, 10px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
  color: var(--wot-tabs-nav-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
  transition: color var(--wot-tabs-duration, 0.3s);
}
.wd-tabs__nav-item.is-active {
  font-weight: var(--wot-tabs-nav-font-weight-active, var(--wot-font-weight-medium, 600));
  color: var(--wot-tabs-nav-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-tabs__nav-item.is-disabled {
  color: var(--wot-tabs-nav-color-disabled, var(--wot-text-disabled, var(--wot-coolgrey-4, #c9cbd4)));
}
.wd-tabs__nav-item-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-tabs  .wd-tabs__nav-item-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  min-width: 0;
}
.wd-tabs__line {
  position: absolute;
  bottom: var(--wot-tabs-nav-line-bottom, var(--wot-n-2, 2px));
  left: 0;
  z-index: 1;
  height: var(--wot-tabs-nav-line-height, var(--wot-n-4, 4px));
  background: var(--wot-tabs-nav-line-bg, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  border-radius: calc(var(--wot-tabs-nav-line-height, var(--wot-n-4, 4px)) / 2);
}
.wd-tabs__line--inner {
  left: 50%;
  transform: translateX(-50%);
}
.wd-tabs__line.is-normal {
  width: var(--wot-tabs-nav-line-width, var(--wot-n-24, 24px));
}
.wd-tabs__line.is-underline {
  bottom: 0;
  height: var(--wot-n-2, 2px);
  border-radius: var(--wot-radius-zero, var(--wot-n-0, 0px));
}
.wd-tabs__line.is-dot {
  bottom: 0;
  width: var(--wot-n-6, 6px);
  height: var(--wot-n-6, 6px);
  border-radius: var(--wot-radius-full, var(--wot-n-full, 9999px));
}
.wd-tabs__container {
  overflow: hidden;
}
.wd-tabs__body {
  position: relative;
  width: 100%;
  height: 100%;
}
.wd-tabs__body.is-animated {
  display: flex;
  transition-property: left;
}
.wd-tabs__map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1;
}
.wd-tabs__map-header {
  position: relative;
  font-size: var(--wot-tabs-map-header-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  line-height: var(--wot-tabs-map-header-line-height, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
