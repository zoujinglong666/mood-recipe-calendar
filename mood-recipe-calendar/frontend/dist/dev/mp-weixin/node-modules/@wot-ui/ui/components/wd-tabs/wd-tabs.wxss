  opacity: 0;
}
.wd-tabs__map-header::after {
  z-index: 3;
}
.wd-tabs__map-body {
  display: flex;
  flex-wrap: wrap;
  padding: var(--wot-tabs-map-body-padding, var(--wot-padding-loose, var(--wot-n-12, 12px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
  background: var(--wot-tabs-map-body-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  transition: transform var(--wot-tabs-duration, 0.3s);
  transform: scaleY(0);
