}
.wd-tabs__map-body.is-open {
  transform: scaleY(1);
}
.wd-tabs__map-btn {
  position: absolute;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  background: var(--wot-tabs-nav-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
