  background: var(--wot-tabs-map-btn-before-bg, linear-gradient(270deg, var(--wot-filled-oppo, var(--wot-base-white, white)) 0%, var(--wot-base-transparent, transparent) 100%));
}
.wd-tabs__map-arrow {
  display: block;
  transition: transform var(--wot-tabs-duration, 0.3s);
}
