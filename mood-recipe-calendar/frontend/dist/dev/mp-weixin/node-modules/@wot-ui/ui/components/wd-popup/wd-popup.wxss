/**
  * 三角形实现尖角样式，适用于背景透明情况
  * @param $size 三角形高，底边为 $size * 2
  * @param $bg 三角形背景颜色
  */
/**
  * 正方形实现尖角样式，适用于背景不透明情况
  * @param $size 正方形边长
  * @param $bg 正方形背景颜色
  * @param $z-index z-index属性值，不得大于外部包裹器
  * @param $box-shadow 阴影
*/
.wd-popup {
  position: fixed;
  max-height: 100%;
  overflow-y: auto;
  background: var(--wot-popup-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
}
.wd-popup  .wd-popup__close {
  position: absolute;
  top: var(--wot-popup-close-margin, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
  right: var(--wot-popup-close-margin, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
  color: var(--wot-popup-close-color, var(--wot-icon-auxiliary, var(--wot-coolgrey-6, #868a9c)));
  font-size: var(--wot-popup-close-size, var(--wot-n-24, 24px));
}
  .wd-popup--center {
  left: 50%;
  top: 50%;
  transform: translate3d(-50%, -50%, 0);
  transform-origin: 0% 0%;
}
  .wd-popup--center.is-round {
  border-radius: var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px)));
}
  .wd-popup--center.wd-transition--zoom-in-enter,  .wd-popup--center.wd-transition--zoom-in-leave-to {
  transform: scale(0.8) translate3d(-50%, -50%, 0) !important;
}
  .wd-popup--center.is-deep.wd-transition--zoom-in-enter,  .wd-popup--center.is-deep.wd-transition--zoom-in-leave-to {
  transform: scale(0.1) translate3d(-50%, -50%, 0) !important;
}
  .wd-popup--left {
  top: 0;
  bottom: 0;
  left: 0;
}
  .wd-popup--left.is-round {
  border-radius: 0 var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) 0;
}
  .wd-popup--right {
  top: 0;
  right: 0;
  bottom: 0;
}
  .wd-popup--right.is-round {
  border-radius: var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) 0 0 var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px)));
}
  .wd-popup--top {
  top: 0;
  left: 0;
  right: 0;
}
  .wd-popup--top.is-round {
  border-radius: 0 0 var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px)));
}
  .wd-popup--bottom {
  right: 0;
  bottom: 0;
  left: 0;
}
  .wd-popup--bottom.is-round {
  border-radius: var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) var(--wot-popup-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) 0 0;
}