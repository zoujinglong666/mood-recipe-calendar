/* 文章场景相关 */
.mood-picker.data-v-3aa47bf0 {
  width: 100%;
}

/* 标题 */
.mood-picker__heading.data-v-3aa47bf0 {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.mood-picker__heading-copy.data-v-3aa47bf0 {
  min-width: 0;
}
.mood-picker__eyebrow.data-v-3aa47bf0 {
  display: block;
  margin-bottom: 6rpx;
  color: var(--mrc-accent);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.mood-picker__title.data-v-3aa47bf0 {
  display: block;
  color: var(--mrc-text-strong);
  font-size: 36rpx;
  font-weight: var(--mrc-fw-heavy);
  line-height: 1.25;
}
.mood-picker__current.data-v-3aa47bf0 {
  min-width: 104rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 28rpx;
  background: var(--mrc-surface-2);
  color: var(--mrc-text-sub);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}
.mood-picker__current--active.data-v-3aa47bf0 {
  border-color: var(--mrc-primary);
  background: var(--mrc-accent-soft);
  color: var(--mrc-accent);
}

/* 大锅仔联动区 */
.mood-picker__hero.data-v-3aa47bf0 {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 40rpx;
  background: radial-gradient(circle at 82% 8%, rgba(255, 197, 61, 0.28), transparent 30%), linear-gradient(145deg, var(--mrc-surface), var(--mrc-surface-peach));
  box-shadow: var(--mrc-shadow-lift), var(--mrc-gloss);
  margin-bottom: 28rpx;
  overflow: hidden;
}
.mood-picker__hero-img.data-v-3aa47bf0 {
  margin-right: 24rpx;
}
.mood-picker__hero-bubble.data-v-3aa47bf0 {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-width: 44%;
  padding: 24rpx;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 26rpx 26rpx 26rpx 8rpx;
  background: var(--mrc-surface);
  box-shadow: var(--mrc-shadow-sm);
}
.mood-picker__hero-mood.data-v-3aa47bf0 {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--mrc-text-deep);
}
.mood-picker__hero-tip.data-v-3aa47bf0 {
  font-size: 24rpx;
  color: var(--mrc-text-sub);
  line-height: 1.5;
}

/* 12 心情网格 4×3，缩短选择路径 */
.mood-picker__grid.data-v-3aa47bf0 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.mood-picker__card.data-v-3aa47bf0 {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 156rpx;
  padding: 12rpx 4rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 24rpx;
  box-shadow: var(--mrc-shadow-soft), var(--mrc-gloss);
  transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}
.mood-picker__card--hover.data-v-3aa47bf0 {
  transform: scale(0.96);
}
.mood-picker__card--active.data-v-3aa47bf0 {
  background: var(--mrc-surface-peach);
  border-color: var(--mrc-primary-deep);
  box-shadow: 0 8rpx 20rpx rgba(239, 90, 60, 0.18), inset 0 0 0 2rpx var(--mrc-primary);
}

/* 选中弹跳 */
@keyframes mood-pop-3aa47bf0 {
0% {
    transform: scale(0.88);
}
50% {
    transform: scale(1.1);
}
100% {
    transform: scale(1);
}
}
.mood-picker__card--pop.data-v-3aa47bf0 {
  animation: mood-pop-3aa47bf0 0.35s ease;
}
.mood-picker__card-icon.data-v-3aa47bf0 {
  width: 84rpx;
  height: 84rpx;
}
.mood-picker__card-label.data-v-3aa47bf0 {
  font-size: 24rpx;
  color: var(--mrc-text-deep);
  font-weight: 600;
  letter-spacing: 1rpx;
}
.mood-picker__card--active .mood-picker__card-label.data-v-3aa47bf0 {
  color: var(--mrc-accent);
  font-weight: 800;
}
.mood-picker__card-check.data-v-3aa47bf0 {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--mrc-primary-deep);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底部确认条 */
.mood-picker__bar.data-v-3aa47bf0 {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 40rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(90, 62, 43, 0.16);
  animation: mood-bar-in-3aa47bf0 0.28s ease;
}
@keyframes mood-bar-in-3aa47bf0 {
from {
    transform: translateY(40rpx);
    opacity: 0;
}
to {
    transform: translateY(0);
    opacity: 1;
}
}
.mood-picker__bar-img.data-v-3aa47bf0 {
  width: 88rpx;
  height: 88rpx;
}
.mood-picker__bar-txt.data-v-3aa47bf0 {
  flex: 1;
  font-size: 28rpx;
  color: var(--mrc-text-deep);
  font-weight: 600;
}
.mood-picker__bar-btn.data-v-3aa47bf0 {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mrc-primary-grad);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(253, 145, 132, 0.35);
}
.mood-picker__bar-btn.data-v-3aa47bf0:active {
  transform: scale(0.95);
}
@media (prefers-reduced-motion: reduce) {
.mood-picker__card.data-v-3aa47bf0,
  .mood-picker__card--pop.data-v-3aa47bf0,
  .mood-picker__bar.data-v-3aa47bf0 {
    animation: none;
    transition: none;
}
}