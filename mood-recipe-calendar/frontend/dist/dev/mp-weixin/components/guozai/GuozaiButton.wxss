/* 小程序原生 button 默认有内边距与伪元素边框，内容会偏移；这里统一 flex 居中并清掉默认边框 */
.gz-btn.data-v-1e33db06 {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--mrc-touch-min);
  margin: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 48rpx;
  color: var(--mrc-color-on-primary);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  transition: transform var(--mrc-motion-fast), opacity var(--mrc-motion-fast);
}
.gz-btn.data-v-1e33db06::after {
  border: 0;
}
.gz-btn--block.data-v-1e33db06 {
  width: 100%;
}

/* 主按钮：渐变整体加深，避开浅端白字看不清；文字加细阴影拉开对比 */
.gz-btn--primary.data-v-1e33db06 {
  background: linear-gradient(135deg, var(--mrc-primary) 0%, var(--mrc-color-primary) 100%);
  color: var(--mrc-color-on-primary);
  text-shadow: 0 1rpx 2rpx rgba(150, 40, 20, 0.28);
  box-shadow: var(--mrc-shadow-coral);
}

/* 次级按钮：浅底 + 深咖字，明确可读 */
.gz-btn--secondary.data-v-1e33db06 {
  background: var(--mrc-surface);
  color: var(--mrc-text-deep);
  border: 2rpx solid var(--mrc-border);
}

/* 深棕按钮：真·深棕底 + 奶白字 */
.gz-btn--dark.data-v-1e33db06 {
  background: linear-gradient(135deg, #5A3323 0%, #3D2519 100%);
  color: #FFF6EA;
  box-shadow: 0 12rpx 26rpx rgba(70, 35, 23, 0.22);
}
.gz-btn--ghost.data-v-1e33db06 {
  background: transparent;
  color: var(--mrc-color-danger);
  font-weight: 700;
}
.gz-btn.is-disabled.data-v-1e33db06 {
  opacity: 0.45;
}
.gz-btn--pressed.data-v-1e33db06 {
  transform: scale(0.985);
  opacity: 0.9;
}