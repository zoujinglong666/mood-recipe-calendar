.safety-tips.data-v-4f864cbd {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 24rpx;
  background: var(--mrc-surface);
  box-shadow: var(--mrc-shadow-soft);
}
.safety-tips__head.data-v-4f864cbd {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.safety-tips__title.data-v-4f864cbd {
  color: var(--mrc-text-deep);
  font-size: 27rpx;
  font-weight: 800;
}
.safety-tips__sub.data-v-4f864cbd {
  color: var(--mrc-text-light);
  font-size: 21rpx;
}
.safety-tip.data-v-4f864cbd {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 0;
}
.safety-tip__badge.data-v-4f864cbd {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  border-radius: 10rpx;
  font-size: 19rpx;
  font-weight: 800;
}
.tip--cook .safety-tip__badge.data-v-4f864cbd {
  background: var(--mrc-surface-sun);
  color: var(--mrc-accent);
}
.tip--avoid .safety-tip__badge.data-v-4f864cbd {
  background: rgba(217, 72, 65, 0.12);
  color: #C44732;
}
.tip--combo .safety-tip__badge.data-v-4f864cbd {
  background: rgba(217, 72, 65, 0.12);
  color: #C44732;
}
.tip--pick .safety-tip__badge.data-v-4f864cbd {
  background: var(--mrc-accent-soft);
  color: var(--mrc-accent);
}
.safety-tip__main.data-v-4f864cbd {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.safety-tip__name.data-v-4f864cbd {
  color: var(--mrc-text);
