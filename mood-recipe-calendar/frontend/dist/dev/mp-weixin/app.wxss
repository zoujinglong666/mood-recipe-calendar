:root,
page {
  /* ---- Wot UI 组件库主题色覆盖（默认蓝 → 品牌珊瑚红） ---- */
  --wd-color-primary: #FF6B5B;
  --wd-color-primary-light-1: #FF7A6C;
  --wd-color-primary-light-2: #FF897C;
  --wd-color-primary-light-3: #FF978C;
  --wd-color-primary-light-4: #FFA69D;
  --wd-color-primary-light-5: #FFB5AD;
  --wd-color-primary-light-6: #FFC4BD;
  --wd-color-primary-light-7: #FFD2CE;
  --wd-color-primary-light-8: #FFE1DE;
  --wd-color-primary-light-9: #FFF0EE;
  --wd-color-primary-dark-2: #CC5649;
  /* ---- 表面层级（清晰对比，根治"灰脏"） ---- */
  --mrc-bg: #F8ECDA; /* 页面底：温暖奶油（比卡片深，制造层次） */
  --mrc-surface: #FFFCF7; /* 卡片：近白暖调，明显浮起 */
  --mrc-surface-2: #FBEBD6; /* 次级面 / 功能条 */
  --mrc-surface-3: #F4E0C5; /* 内嵌深一层 */
  --mrc-surface-peach: #FFF1E7; /* 角色引导 / 轻强调表面 */
  --mrc-surface-mint: #EDF8F1; /* 记录 / 成功表面 */
  --mrc-surface-sun: #FFF8E8; /* 数据 / 高光表面 */
  /* ---- 品牌珊瑚（更饱和、更敢用） ---- */
  --mrc-primary: #FF9D82; /* 浅珊瑚 */
  --mrc-primary-deep: #FF6B5B; /* 深珊瑚红（行动主色） */
  --mrc-primary-grad: linear-gradient(135deg, #FFB98C 0%, #FF6B5B 100%);
  --mrc-accent: #EF5A3C; /* 强调深珊瑚 */
  --mrc-accent-soft: rgba(239, 90, 60, 0.14);
  /* ---- 吸睛点缀（克制使用） ---- */
  --mrc-pop: #FFC53D; /* 暖阳黄 */
  --mrc-mint: #28C2A0; /* 清新薄荷（强对比） */
  --mrc-blue: #6FB4EA; /* 雾蓝 */
  /* ---- 文字 ---- */
  --mrc-text: #6A4A37; /* 正文 暖褐 */
  --mrc-text-deep: #3D2519; /* 标题 深咖 */
  --mrc-text-strong: #2C1810; /* 大标题 最深 */
  --mrc-text-sub: #A1826A; /* 辅助 */
  --mrc-text-light: #C4A88A; /* 占位 / 次要 */
  /* ---- 描边 ---- */
  --mrc-border: #EAD2B6; /* 常规 */
  --mrc-border-light: #F0DCC2; /* 浅 */
  --mrc-border-strong: #E2BD98; /* 强 */
  /* ---- 阴影（上色 + 分层 = 高级感） ---- */
  --mrc-shadow-sm: 0 4rpx 12rpx rgba(176, 116, 74, 0.10);
  --mrc-shadow: 0 10rpx 28rpx rgba(176, 116, 74, 0.14);
  --mrc-shadow-soft: 0 6rpx 18rpx rgba(176, 116, 74, 0.08);
  --mrc-shadow-coral: 0 12rpx 26rpx rgba(255, 107, 91, 0.40);
  --mrc-shadow-lift: 0 14rpx 34rpx rgba(112, 72, 47, 0.12);
  --mrc-gloss: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  /* ---- 字号（rpx） ---- */
  --mrc-font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --mrc-fw-regular: 400;
  --mrc-fw-medium: 500;
  --mrc-fw-semibold: 600;
  --mrc-fw-bold: 700;
  --mrc-fw-heavy: 800;
  --mrc-fs-lg: 44rpx;
  --mrc-fs-title: 34rpx;
  --mrc-fs-body: 28rpx;
  --mrc-fs-sub: 24rpx;
  --mrc-fs-xs: 20rpx;
  /* ---- 圆角 ---- */
  --mrc-radius-lg: 28rpx;
  --mrc-radius-md: 18rpx;
  --mrc-radius-pill: 50rpx;
  /* ---- 间距 ---- */
  --mrc-space-lg: 32rpx;
  --mrc-space-md: 24rpx;
  --mrc-space-sm: 16rpx;
  /* ---- 旧别名兼容映射（既有页面引用，保持可用） ---- */
  --mrc-bg-card: var(--mrc-surface);
  --mrc-bg-bar: var(--mrc-surface-2);
  --mrc-bg-soft: var(--mrc-surface-2);
  --mrc-bg-warm: #FFF6E6; /* 暖色卡片（轻于底色，仍有暖意） */
  --mrc-bg-alt: #F2E6D2;
  --mrc-warm: #FBE5CC;
  --mrc-warm-light: #FCEFD9;
  --mrc-brown: #C4956A;
  --mrc-white: #FFFCF7;
  --mrc-border-soft: var(--mrc-border-light);
  --mrc-text-mid: #8B6B55;
}

/* ---------- 全局排版基础 ---------- */
page,
.page-wraper,
.mrc-page {
  font-family: var(--mrc-font-family);
}
button,
input,
textarea {
  font-family: inherit;
}

/* ---------- 页面骨架 ---------- */
.mrc-page {
  min-height: 100vh;
  background: var(--mrc-bg);
  color: var(--mrc-text);
  padding: 0 var(--mrc-space-lg);
  padding-bottom: calc(var(--mrc-space-lg) * 2 + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 整页暖色光晕背景（hero 区可用，制造氛围与深度） */
.mrc-hero {
  background: radial-gradient(110% 80% at 12% -10%, #FFE6C9 0%, rgba(255, 230, 201, 0) 55%), radial-gradient(100% 80% at 105% 0%, #FFD8D2 0%, rgba(255, 216, 210, 0) 50%), var(--mrc-bg);
}

/* ---------- 卡片 ---------- */
.mrc-card {
  background: var(--mrc-surface);
  border-radius: var(--mrc-radius-lg);
  padding: var(--mrc-space-md);
  border: 1rpx solid var(--mrc-border-light);
  box-shadow: var(--mrc-shadow), var(--mrc-gloss);
  box-sizing: border-box;
}

/* ---------- 主按钮（珊瑚渐变胶囊 + 上色投影） ---------- */
.mrc-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--mrc-radius-pill);
  background: var(--mrc-primary-grad);
  color: #fff;
  font-size: var(--mrc-fs-title);
  font-weight: 700;
  box-shadow: var(--mrc-shadow-coral), var(--mrc-gloss);
  letter-spacing: 2rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.mrc-btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 91, 0.32);
}

/* 次按钮（描边） */
.mrc-btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--mrc-radius-pill);
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-primary);
  color: var(--mrc-accent);
  font-size: var(--mrc-fs-title);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.mrc-btn-outline:active {
  background: #fff3ec;
}

/* ---------- 标签 chip ---------- */
.mrc-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--mrc-radius-pill);
  background: var(--mrc-surface-2);
  color: var(--mrc-text-sub);
  font-size: var(--mrc-fs-xs);
  margin-right: var(--mrc-space-sm);
}
.mrc-tag--accent {
  background: var(--mrc-accent-soft);
  color: var(--mrc-accent);
}

/* ---------- 区块标题（左侧珊瑚色条） ---------- */
.mrc-section-title {
  font-size: var(--mrc-fs-title);
  font-weight: 700;
  color: var(--mrc-text-deep);
  margin: var(--mrc-space-lg) 0 var(--mrc-space-md);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mrc-section-title::before {
  content: "";
  width: 8rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: var(--mrc-primary-grad);
}

/* ---------- 心情色映射（类名用英文字尾，避免 WXSS 编译报错） ---------- */
.mrc-mood--happy {
  --mrc-mood: #FFC53D;
} /* 开心 */
.mrc-mood--calm {
  --mrc-mood: #28C2A0;
} /* 平静 */
.mrc-mood--tired {
  --mrc-mood: #8FB8E0;
} /* 疲惫 */
.mrc-mood--anxious {
  --mrc-mood: #FF9D6E;
} /* 焦虑 */
.mrc-mood--sad {
  --mrc-mood: #7FA9D6;
} /* 难过 */
.mrc-mood--hungry {
  --mrc-mood: #FF7A5C;
} /* 嘴馋 */
.mrc-mood--low {
  --mrc-mood: #A9B0BD;
} /* 低落 */
.mrc-mood--homesick {
  --mrc-mood: #FFB366;
} /* 想家 */
/* ============================================================
   设计稿整页模式（页面视觉主体 = 高保真设计稿 PNG）
   ============================================================ */
.dpage {
  min-height: 100vh;
  background: var(--mrc-bg);
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 底部悬浮操作条（奶油磨砂） */
.dbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border);
  border-radius: 48rpx;
  box-shadow: var(--mrc-shadow);
  z-index: 30;
}
.dbar__btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: var(--mrc-surface-2);
  color: var(--mrc-text-deep);
  font-size: 26rpx;
  font-weight: 600;
  gap: 8rpx;
  transition: transform 0.12s ease;
  cursor: pointer;
}
.dbar__btn:active {
  transform: scale(0.96);
}
.dbar__btn--primary {
  background: var(--mrc-primary-grad);
  color: #fff;
  box-shadow: var(--mrc-shadow-coral), var(--mrc-gloss);
}
.dbar__btn--ghost {
  background: rgba(255, 255, 255, 0.7);
}
.dbar__btn--slim {
  flex: 0 0 auto;
  padding: 0 32rpx;
}

/* ============================================================
   锅仔动画系统
   ============================================================ */
/* 呼吸浮动 — 常驻，给锅仔生命感 */
@keyframes guozai-breathe {
0%, 100% {
    transform: translateY(0) scale(1);
}
50% {
    transform: translateY(-8rpx) scale(1.02);
}
}
.guozai-breathe {
  animation: guozai-breathe 3s ease-in-out infinite;
}

/* 点击弹跳 — 交互反馈 */
@keyframes guozai-bounce {
0% {
    transform: scale(1);
}
30% {
    transform: scale(0.9);
}
50% {
    transform: scale(1.1);
}
70% {
    transform: scale(0.97);
}
100% {
    transform: scale(1);
}
}
.guozai-bounce {
  animation: guozai-bounce 0.5s ease;
}

/* 开心转圈 — 成功态 */
@keyframes guozai-spin {
0% {
    transform: rotate(0deg) scale(1);
}
25% {
    transform: rotate(90deg) scale(1.1);
}
50% {
    transform: rotate(180deg) scale(1);
}
75% {
    transform: rotate(270deg) scale(1.1);
}
100% {
    transform: rotate(360deg) scale(1);
}
}
.guozai-spin {
  animation: guozai-spin 0.8s ease-in-out;
}

/* 星星浮动 — 成功态装饰 */
@keyframes star-float {
0% {
    opacity: 0;
    transform: translateY(0) scale(0.5);
}
50% {
    opacity: 1;
    transform: translateY(-20rpx) scale(1);
}
100% {
    opacity: 0;
    transform: translateY(-40rpx) scale(0.8);
}
}
.star-float {
  animation: star-float 1.5s ease-in-out infinite;
}

/* 淡入上移 — 弹窗/页面入场 */
@keyframes fade-up {
0% {
    opacity: 0;
    transform: translateY(20rpx);
}
100% {
    opacity: 1;
    transform: translateY(0);
}
}
.fade-up {
  animation: fade-up 0.4s ease-out;
}

/* 缩放入场 — 弹窗 */
@keyframes pop-in {
0% {
    opacity: 0;
    transform: scale(0.8);
}
70% {
    transform: scale(1.05);
}
100% {
    opacity: 1;
    transform: scale(1);
}
}
.pop-in {
  animation: pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 减少动画偏好 */
@media (prefers-reduced-motion: reduce) {
.guozai-breathe,
  .guozai-bounce,
  .guozai-spin,
  .star-float,
  .fade-up,
  .pop-in {
    animation: none !important;
}
}
/* ============================================================
   深色模式（暖调暗夜，保持治愈感，不用纯黑）
   ============================================================ */
.mrc-dark {
  --mrc-bg: #2A1F18;
  --mrc-surface: #382A20;
  --mrc-surface-2: #423126;
  --mrc-surface-3: #4D392C;
  --mrc-surface-peach: #3D2B22;
  --mrc-surface-mint: #24332B;
  --mrc-surface-sun: #3A2E1E;
  --mrc-primary: #FF9D82;
  --mrc-primary-deep: #FF7A6B;
  --mrc-accent: #FF8A6E;
  --mrc-accent-soft: rgba(255, 138, 110, 0.2);
  --mrc-pop: #FFD93D;
  --mrc-mint: #4AD4B0;
  --mrc-blue: #8BC4EA;
  --mrc-text: #D4BFA8;
  --mrc-text-deep: #F0E0CC;
  --mrc-text-strong: #FFF5E8;
  --mrc-text-sub: #A89078;
  --mrc-text-light: #7A6654;
  --mrc-border: #5A4434;
  --mrc-border-light: #4D392C;
  --mrc-border-strong: #6B5240;
  --mrc-shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  --mrc-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.35);
  --mrc-shadow-soft: 0 6rpx 18rpx rgba(0, 0, 0, 0.25);
  --mrc-shadow-coral: 0 12rpx 26rpx rgba(255, 122, 107, 0.3);
  --mrc-shadow-lift: 0 14rpx 34rpx rgba(0, 0, 0, 0.3);
  --mrc-gloss: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  --mrc-bg-card: var(--mrc-surface);
  --mrc-bg-bar: var(--mrc-surface-2);
  --mrc-bg-soft: var(--mrc-surface-2);
  --mrc-bg-warm: #3A2B20;
  --mrc-bg-alt: #33261D;
  --mrc-warm: #3D2B22;
  --mrc-warm-light: #423126;
  --mrc-brown: #8A6E55;
  --mrc-white: #382A20;
  --mrc-border-soft: var(--mrc-border-light);
  --mrc-text-mid: #B89E84;
}

/* 深色模式下 page 背景同步 */
page:has(.mrc-dark),
.mrc-dark {
  background: var(--mrc-bg);
}
page {
  background: var(--mrc-bg);
  font-family: var(--mrc-font-family);
  color: var(--mrc-text);
}
.page-wraper {
  min-height: calc(100vh - var(--window-top));
  box-sizing: border-box;
  background: var(--mrc-bg);
}
