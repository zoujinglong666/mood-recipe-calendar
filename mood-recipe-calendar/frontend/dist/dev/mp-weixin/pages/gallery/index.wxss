.gallery-page.data-v-5a43f0bf {
  min-height: 100vh;
  background: var(--mrc-bg);
  padding: 0 32rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 签到卡片 */
.checkin-card.data-v-5a43f0bf {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--mrc-surface-peach), var(--mrc-surface-sun));
  border: 2rpx solid var(--mrc-border);
  border-radius: 32rpx;
  padding: 32rpx;
  margin: 12rpx 0 24rpx;
  box-shadow: var(--mrc-shadow);
}
.checkin-card__left.data-v-5a43f0bf {
  flex: 1;
  padding-right: 20rpx;
}
.checkin-card__head.data-v-5a43f0bf {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.checkin-card__label.data-v-5a43f0bf {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mrc-text-deep);
}
.checkin-card__ready.data-v-5a43f0bf {
  font-size: 24rpx;
  color: var(--mrc-accent);
  background: var(--mrc-accent-soft);
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 600;
}
.checkin-card__streak.data-v-5a43f0bf {
  font-size: 28rpx;
  color: var(--mrc-text);
}
.checkin-card__num.data-v-5a43f0bf {
  font-size: 40rpx;
  font-weight: var(--mrc-fw-heavy);
  color: var(--mrc-accent);
  margin: 0 4rpx;
}
.checkin-card__hint.data-v-5a43f0bf {
  display: block;
  font-size: 24rpx;
  color: var(--mrc-text-sub);
  margin-top: 8rpx;
}
.checkin-bar.data-v-5a43f0bf {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 8rpx;
  margin-top: 20rpx;
  overflow: hidden;
}
.checkin-bar__inner.data-v-5a43f0bf {
  height: 100%;
  background: linear-gradient(90deg, var(--mrc-primary), var(--mrc-accent));
  border-radius: 8rpx;
  transition: width 0.5s ease;
}
.checkin-card__right.data-v-5a43f0bf {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.checkin-card__guozai.data-v-5a43f0bf {
  width: 120rpx;
  height: 120rpx;
}
.checkin-btn.data-v-5a43f0bf {
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  background: var(--mrc-primary-grad);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 139, 106, 0.4);
}
.checkin-btn--done.data-v-5a43f0bf {
  background: var(--mrc-green);
  box-shadow: none;
}
.checkin-btn--ready.data-v-5a43f0bf {
  background: linear-gradient(135deg, var(--mrc-yellow), #ffb347);
}
.checkin-btn.data-v-5a43f0bf:active {
  transform: scale(0.96);
}

/* Tab */
.gallery-tabs.data-v-5a43f0bf {
  display: flex;
  background: var(--mrc-surface-2);
  border-radius: 50rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}
.gallery-tab.data-v-5a43f0bf {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  color: var(--mrc-text-sub);
  font-weight: 500;
  transition: all 0.2s ease;
}
.gallery-tab--active.data-v-5a43f0bf {
  background: var(--mrc-surface);
  color: var(--mrc-accent);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(90, 62, 43, 0.08);
}

/* 内容资产 */
.asset-intro.data-v-5a43f0bf {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--mrc-shadow-soft);
}
.asset-intro__guozai.data-v-5a43f0bf {
  width: 100rpx;
  height: 100rpx;
}
.asset-intro__text.data-v-5a43f0bf {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.asset-intro__title.data-v-5a43f0bf {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mrc-text-deep);
}
.asset-intro__sub.data-v-5a43f0bf {
  font-size: 24rpx;
  color: var(--mrc-text-sub);
}
.asset-group.data-v-5a43f0bf {
  margin-bottom: 32rpx;
}
.asset-group__title.data-v-5a43f0bf {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mrc-text);
  display: block;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--mrc-primary);
}
.asset-grid.data-v-5a43f0bf {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}
.asset-item.data-v-5a43f0bf {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 24rpx;
  padding: 20rpx 8rpx;
  transition: all 0.15s ease;
}
.asset-item.data-v-5a43f0bf:active {
  transform: scale(0.94);
  border-color: var(--mrc-primary);
}
.asset-item__img.data-v-5a43f0bf {
  width: 110rpx;
  height: 110rpx;
}
.asset-item__name.data-v-5a43f0bf {
  font-size: 22rpx;
  color: var(--mrc-text-sub);
}

/* 周边商城 */
.shop-grid.data-v-5a43f0bf {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}
.shop-card.data-v-5a43f0bf {
  background: var(--mrc-white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(121, 73, 53, 0.06);
  border: 2rpx solid var(--mrc-border-light);
}
.shop-card.data-v-5a43f0bf:active {
  transform: scale(0.97);
}
.shop-card__img.data-v-5a43f0bf {
  width: 100%;
  height: 280rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border-light);
  box-shadow: var(--mrc-shadow-soft);
}
.shop-card__body.data-v-5a43f0bf {
  padding: 20rpx;
}
.shop-card__name.data-v-5a43f0bf {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mrc-text-deep);
}
.shop-card__desc.data-v-5a43f0bf {
  display: block;
  font-size: 22rpx;
  color: var(--mrc-text-sub);
  margin-top: 8rpx;
  height: 56rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.shop-card__bottom.data-v-5a43f0bf {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.shop-card__price.data-v-5a43f0bf {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.shop-card__price--now.data-v-5a43f0bf {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--mrc-accent);
}
.shop-card__price--exchange.data-v-5a43f0bf {
  font-size: 20rpx;
  color: var(--mrc-text-light);
}
.shop-card__buy.data-v-5a43f0bf {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--mrc-primary), var(--mrc-primary-deep));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 139, 106, 0.35);
}

/* 我的订单 */
.order-card.data-v-5a43f0bf {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--mrc-white);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid var(--mrc-border-light);
}
.order-card__img.data-v-5a43f0bf {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border-light);
  box-shadow: var(--mrc-shadow-soft);
  flex-shrink: 0;
}
.order-card__main.data-v-5a43f0bf {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}
.order-card__name.data-v-5a43f0bf {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mrc-text-deep);
}
.order-card__type.data-v-5a43f0bf {
  font-size: 22rpx;
  color: var(--mrc-accent);
  background: rgba(232, 131, 107, 0.12);
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.order-card__no.data-v-5a43f0bf {
  font-size: 20rpx;
  color: var(--mrc-text-light);
}
.order-card__right.data-v-5a43f0bf {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}
.order-card__amount.data-v-5a43f0bf {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--mrc-text-deep);
}
.order-card__status.data-v-5a43f0bf {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--mrc-bg-card);
  color: var(--mrc-text-sub);
}
.order-card__status--paid.data-v-5a43f0bf {
  background: rgba(107, 203, 119, 0.15);
  color: var(--mrc-green);
}
.order-card__status--pending.data-v-5a43f0bf {
  background: rgba(255, 217, 61, 0.2);
  color: #c99700;
}

/* 空状态 */
.gallery-empty.data-v-5a43f0bf {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 80rpx 0;
}
.gallery-empty__img.data-v-5a43f0bf {
  width: 220rpx;
  height: 220rpx;
}
.gallery-empty__text.data-v-5a43f0bf {
  font-size: 26rpx;
  color: var(--mrc-text-sub);
}

/* 底部 */
.gallery-footer.data-v-5a43f0bf {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0 20rpx;
}
.gallery-footer__guozai.data-v-5a43f0bf {
  width: 60rpx;
  height: 60rpx;
}
.gallery-footer__text.data-v-5a43f0bf {
  font-size: 24rpx;
  color: var(--mrc-text-light);
}

/* 购买弹窗 */
.buy-mask.data-v-5a43f0bf {
  position: fixed;
  inset: 0;
  background: rgba(90, 62, 43, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.buy-pop.data-v-5a43f0bf {
  width: 100%;
  background: var(--mrc-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.buy-pop__img.data-v-5a43f0bf {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: var(--mrc-surface);
  border: 2rpx solid var(--mrc-border-light);
  margin-bottom: 16rpx;
}
.buy-pop__name.data-v-5a43f0bf {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--mrc-text-deep);
}
.buy-pop__desc.data-v-5a43f0bf {
  font-size: 24rpx;
  color: var(--mrc-text-sub);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}
.buy-pop__options.data-v-5a43f0bf {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.buy-option.data-v-5a43f0bf {
  border: 3rpx solid var(--mrc-border);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  transition: all 0.15s ease;
}
.buy-option--active.data-v-5a43f0bf {
  border-color: var(--mrc-accent);
  background: rgba(232, 131, 107, 0.06);
}
.buy-option__top.data-v-5a43f0bf {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.buy-option__name.data-v-5a43f0bf {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mrc-text-deep);
}
.buy-option__price.data-v-5a43f0bf {
  font-size: 36rpx;
  font-weight: var(--mrc-fw-heavy);
  color: var(--mrc-accent);
}
.buy-option__sub.data-v-5a43f0bf {
  font-size: 22rpx;
  color: var(--mrc-text-sub);
}
.buy-option__sub--ok.data-v-5a43f0bf {
  color: var(--mrc-green);
}
.buy-pop__btn.data-v-5a43f0bf {
  width: 100%;
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--mrc-primary), var(--mrc-primary-deep));
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(255, 139, 106, 0.35);
}
.buy-pop__btn--disabled.data-v-5a43f0bf {
  background: var(--mrc-border);
  color: var(--mrc-text-light);
  box-shadow: none;
}
.buy-pop__btn.data-v-5a43f0bf:active {
  transform: scale(0.98);
}
.buy-pop__close.data-v-5a43f0bf {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(90deg);
}