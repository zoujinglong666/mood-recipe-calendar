.privacy-page.data-v-26151888 {
  min-height: 100vh;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--mrc-bg);
}
.privacy-hero.data-v-26151888 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 280rpx;
  margin: 12rpx 0 24rpx;
  padding: 32rpx;
  border: 2rpx solid var(--mrc-border);
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--mrc-surface-peach), var(--mrc-surface-sun));
  box-sizing: border-box;
}
.privacy-hero image.data-v-26151888 {
  width: 210rpx;
  height: 210rpx;
  margin-right: -34rpx;
}
