.about-page.data-v-6b4e7e2d {
  min-height: 100vh;
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.about-hero.data-v-6b4e7e2d {
  position: relative;
  min-height: 410rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 40rpx;
  background: radial-gradient(circle at 72% 22%, rgba(255, 197, 61, 0.28), transparent 20%), var(--mrc-surface-peach);
  box-shadow: var(--mrc-shadow-soft);
}
