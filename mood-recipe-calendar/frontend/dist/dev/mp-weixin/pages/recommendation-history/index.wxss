}
.history-card__meta.data-v-0fe881ac {
  margin-top: 8rpx;
  color: var(--mrc-text-sub);
  font-size: 20rpx;
}
.history-card__cook.data-v-0fe881ac {
  min-width: 74rpx;
  padding: 14rpx 12rpx;
  border-radius: 999rpx;
