.history-page.data-v-0fe881ac {
  min-height: 100vh;
  padding: 0 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--mrc-bg);
}
.history-scroll.data-v-0fe881ac {
  height: calc(100vh - 120rpx);
}
.day-group.data-v-0fe881ac {
  padding: 22rpx 0 0;
}
.day-label.data-v-0fe881ac {
  display: block;
  margin: 0 6rpx 12rpx;
  color: var(--mrc-text-sub);
  font-size: 21rpx;
  font-weight: 800;
}
.history-card.data-v-0fe881ac {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
  padding: 16rpx;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 26rpx;
  background: var(--mrc-surface);
  box-shadow: var(--mrc-shadow-soft);
}
.history-card__image.data-v-0fe881ac {
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 auto;
  border-radius: 20rpx;
  background: var(--mrc-surface-peach);
}
.history-card__body.data-v-0fe881ac {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}
.history-card__source.data-v-0fe881ac {
  color: var(--mrc-accent);
  font-size: 19rpx;
  font-weight: 800;
}
.history-card__name.data-v-0fe881ac {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--mrc-text-deep);
