.wl.data-v-a396f15d {
  min-height: 100vh;
  padding: 0 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.wl-banner.data-v-a396f15d {
  margin: 8rpx 0 24rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 28rpx;
  background: var(--mrc-surface);
  box-shadow: var(--mrc-shadow-soft), var(--mrc-gloss);
}
.wl-banner__title.data-v-a396f15d {
  display: block;
  color: var(--mrc-text-strong);
  font-size: 32rpx;
  font-weight: 800;
}
.wl-banner__sub.data-v-a396f15d {
  display: block;
  margin-top: 8rpx;
  color: var(--mrc-text-sub);
  font-size: 23rpx;
  line-height: 1.5;
}
.wl-empty.data-v-a396f15d {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 40rpx;
  color: var(--mrc-text-sub);
  font-size: 26rpx;
  text-align: center;
}
.wl-empty image.data-v-a396f15d {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.8;
}
.wl-empty__title.data-v-a396f15d {
  color: var(--mrc-text-deep);
  font-size: 30rpx;
  font-weight: 800;
}
.wl-empty__sub.data-v-a396f15d {
  max-width: 480rpx;
  line-height: 1.5;
}
.wl-empty__btn.data-v-a396f15d {
  margin-top: 12rpx;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background: var(--mrc-primary-grad);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: var(--mrc-shadow-coral);
}
.wl-empty__btn.data-v-a396f15d:active {
  transform: scale(0.97);
}
.wl-list.data-v-a396f15d {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.wl-item.data-v-a396f15d {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 28rpx;
  background: var(--mrc-surface);
  box-shadow: var(--mrc-shadow-soft), var(--mrc-gloss);
  transition: transform 0.15s ease;
}
.wl-item.data-v-a396f15d:active {
