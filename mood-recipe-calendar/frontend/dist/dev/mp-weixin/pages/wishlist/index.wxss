}
.wl-item__img.data-v-a396f15d {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--mrc-surface-2);
}
.wl-item__main.data-v-a396f15d {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.wl-item__name.data-v-a396f15d {
  color: var(--mrc-text-strong);
  font-size: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wl-item__desc.data-v-a396f15d {
  color: var(--mrc-text-sub);
  font-size: 22rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
}
.wl-item__meta.data-v-a396f15d {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.wl-item__tag.data-v-a396f15d {
