}
.wl-heart.data-v-a396f15d {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 40rpx;
  color: var(--mrc-text-light);
  background: var(--mrc-surface-2);
  transition: transform 0.15s ease, color 0.15s ease;
}
.wl-heart.is-on.data-v-a396f15d {
  color: var(--mrc-primary-deep);
