/* 文章场景相关 */
.record-page.data-v-e218755a {
  min-height: 100vh;
  padding: 0 32rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.record-intro.data-v-e218755a {
  position: relative;
  display: flex;
  min-height: 176rpx;
  margin: 4rpx 0 24rpx;
  padding: 28rpx 28rpx 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid var(--mrc-border);
  border-radius: 36rpx;
  background: linear-gradient(145deg, var(--mrc-surface), var(--mrc-surface-peach));
  box-shadow: var(--mrc-shadow-soft), var(--mrc-gloss);
}
.record-intro__copy.data-v-e218755a {
  position: relative;
  z-index: 1;
  max-width: 76%;
}
.record-intro__eyebrow.data-v-e218755a, .record-intro__title.data-v-e218755a, .record-intro__sub.data-v-e218755a {
  display: block;
}
.record-intro__eyebrow.data-v-e218755a {
  margin-bottom: 8rpx;
  color: var(--mrc-accent);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.record-intro__title.data-v-e218755a {
  color: var(--mrc-text-strong);
  font-size: 34rpx;
  font-weight: var(--mrc-fw-heavy);
  line-height: 1.3;
}
.record-intro__sub.data-v-e218755a {
  margin-top: 8rpx;
  color: var(--mrc-text-sub);
  font-size: 22rpx;
  line-height: 1.45;
}
.record-intro__guozai.data-v-e218755a {
  position: absolute;
  right: -4rpx;
  bottom: -12rpx;
  width: 142rpx;
  height: 142rpx;
}

/* 拍照区 */
.record-photo.data-v-e218755a {
  position: relative;
  width: 100%;
  height: 344rpx;
  background: radial-gradient(circle at 78% 18%, rgba(255, 197, 61, 0.22), transparent 28%), var(--mrc-surface-sun);
  border: 2rpx dashed var(--mrc-border-strong);
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.record-photo__img.data-v-e218755a {
  width: 100%;
  height: 100%;
}
.record-photo.data-v-e218755a:active {
  opacity: 0.88;
}
.record-photo__camera.data-v-e218755a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  background: var(--mrc-surface);
  border-radius: 32rpx;
  box-shadow: var(--mrc-shadow-sm);
  margin-bottom: 16rpx;
}
.record-photo__title.data-v-e218755a {
  color: var(--mrc-text-deep);
  font-size: 30rpx;
  font-weight: 800;
}
.record-photo__tip.data-v-e218755a {
  margin-top: 8rpx;
  font-size: 27rpx;
  color: var(--mrc-text-sub);
}
.record-photo__change.data-v-e218755a {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 36rpx;
  background: rgba(44, 24, 16, 0.72);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
}
.record-photo__uploading.data-v-e218755a {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(44, 24, 16, 0.45);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
.record-form-card.data-v-e218755a, .record-mood-card.data-v-e218755a, .record-textarea.data-v-e218755a {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 32rpx;
  background: var(--mrc-surface);
  box-shadow: var(--mrc-shadow-soft), var(--mrc-gloss);
}
.record-section-title.data-v-e218755a {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.record-section-title__num.data-v-e218755a {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--mrc-accent-soft);
  color: var(--mrc-accent);
  font-size: 24rpx;
  font-weight: var(--mrc-fw-heavy);
}
.record-section-title__main.data-v-e218755a, .record-section-title__sub.data-v-e218755a {
  display: block;
}
.record-section-title__main.data-v-e218755a {
  color: var(--mrc-text-strong);
  font-size: 29rpx;
  font-weight: 800;
}
.record-section-title__sub.data-v-e218755a {
  margin-top: 4rpx;
  color: var(--mrc-text-sub);
  font-size: 20rpx;
}
.record-input.data-v-e218755a {
  display: flex;
  align-items: center;
  background: var(--mrc-surface-2);
  border: 2rpx solid var(--mrc-border-light);
  border-radius: 24rpx;
  padding: 0 24rpx;
  height: 92rpx;
  margin-bottom: 14rpx;
}
.record-input__label.data-v-e218755a {
  font-size: 27rpx;
  color: var(--mrc-text-deep);
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.record-input__field.data-v-e218755a {
  flex: 1;
  font-size: 30rpx;
  color: var(--mrc-text-deep);
  text-align: right;
}
.record-input__placeholder.data-v-e218755a {
  color: var(--mrc-text-light);
}
.record-textarea__head.data-v-e218755a {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.record-textarea__title.data-v-e218755a, .record-textarea__sub.data-v-e218755a {
  display: block;
}
.record-textarea__title.data-v-e218755a {
  color: var(--mrc-text-strong);
  font-size: 29rpx;
  font-weight: 800;
}
.record-textarea__sub.data-v-e218755a {
  margin-top: 5rpx;
  color: var(--mrc-text-sub);
  font-size: 20rpx;
}
.record-textarea__count.data-v-e218755a {
  color: var(--mrc-text-light);
  font-size: 21rpx;
}
.record-textarea__field.data-v-e218755a {
  width: 100%;
  min-height: 130rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: var(--mrc-surface-2);
  font-size: 27rpx;
  color: var(--mrc-text-deep);
  line-height: 1.6;
}
.record-textarea__placeholder.data-v-e218755a {
  color: var(--mrc-text-light);
}

/* 烹饪时间 */
.record-time.data-v-e218755a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 18rpx 0 22rpx;
  border-radius: 24rpx;
  background: var(--mrc-surface-sun);
}
.record-time__label.data-v-e218755a {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--mrc-text-deep);
  font-weight: 600;
}
.record-time__tag.data-v-e218755a {
  font-size: 25rpx;
  color: var(--mrc-text-deep);
  background: var(--mrc-surface-sun);
  padding: 10rpx 12rpx 10rpx 22rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--mrc-border-light);
  display: flex;
  align-items: center;
}
.record-time__arrow.data-v-e218755a {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: var(--mrc-text-light);
}

/* 发布按钮 */
.record-submit.data-v-e218755a {
  padding-top: 4rpx;
}
.record-submit__btn.data-v-e218755a {
  width: 100%;
  min-height: 112rpx;
  flex-direction: column;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mrc-primary-grad);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 24rpx rgba(253, 145, 132, 0.35);
  letter-spacing: 4rpx;
}
.record-submit__sub.data-v-e218755a {
  margin-top: 5rpx;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0;
  opacity: 0.84;
}
.record-submit__btn--disabled.data-v-e218755a {
  opacity: 0.58;
  box-shadow: none;
}
.record-submit__btn.data-v-e218755a:active {
  transform: scale(0.97);
}
@media (prefers-reduced-motion: reduce) {
.record-submit__btn.data-v-e218755a {
    transition: none;
}
}