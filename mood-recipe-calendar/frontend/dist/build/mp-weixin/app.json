{
  "pages": [
    "pages/index/index",
    "pages/login/index",
    "pages/mood/index",
    "pages/profile/index",
    "pages/recipe/index",
    "pages/record/detail",
    "pages/record/edit",
    "pages/record/index",
    "pages/settings/index",
    "pages/admin/feedback/index",
    "pages/admin/recipes/edit",
    "pages/admin/recipes/index"
  ],
  "subPackages": [
    {
      "root": "pages/about",
      "pages": [
        "index"
      ]
    },
    {
      "root": "pages/privacy",
      "pages": [
        "index"
      ]
    },
    {
      "root": "subpkg-content",
      "pages": [
        "album/index",
        "calendar/index",
        "deals/index",
        "gallery/index",
        "report/index",
        "timeline/index"
      ]
    },
    {
      "root": "subpkg-planning",
      "pages": [
        "cooking/index",
        "daily-meal-plan/index",
        "meal-agent/index",
        "recipe-library/index",
        "weekly-plan/detail",
        "weekly-plan/index"
      ]
    },
    {
      "root": "subpkg-settings",
      "pages": [
        "feedback/index",
        "fridge/index",
        "membership/index",
        "personality/index",
        "preferences/index"
      ]
    }
  ],
  "window": {
    "navigationStyle": "custom",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "心情菜谱日历",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "backgroundColorTop": "@bgColorTop",
    "backgroundColorBottom": "@bgColorBottom",
    "enablePullDownRefresh": false,
    "onReachBottomDistance": 50
  },
  "tabBar": {
    "custom": true,
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index"
      },
      {
        "pagePath": "pages/record/index"
      },
      {
        "pagePath": "pages/profile/index"
      }
    ]
  },
  "themeLocation": "theme.json",
  "darkmode": true,
  "__usePrivacyCheck__": true,
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "layout-default-uni": "/layouts/default",
    "layout-tabbar-uni": "/layouts/tabbar"
  }
}
