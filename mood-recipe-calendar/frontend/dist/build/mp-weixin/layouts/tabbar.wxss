.mrc-layout-root{min-height:100vh;box-sizing:border-box}.mrc-tabbar{--wot-tabbar-bg-color: var(--mrc-white);--wot-tabbar-title-color: var(--mrc-text-sub);--wot-tabbar-title-active-color: var(--mrc-accent);--wot-tabbar-border-color: var(--mrc-border)}.mrc-tabbar__icon{width:48rpx;height:48rpx;transition:transform .2s ease,filter .2s ease}.mrc-tabbar__icon--active{filter:none;transform:scale(1.1)}.mrc-tabbar__icon--inactive{filter:grayscale(.6) opacity(.6);transform:scale(.9)}
